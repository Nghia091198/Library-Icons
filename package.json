{
  "name": "lib-icons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file=.env --watch --import tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck:boundaries && vite build && tsup",
    "start": "node --env-file=.env dist/server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:boundaries": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.46.1",
    "@xmldom/xmldom": "^0.9.8",
    "antd": "^5.22.0",
    "hono": "^4.6.12",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "svgo": "^3.3.2",
    "swr": "^2.2.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
